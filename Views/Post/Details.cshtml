@model BlogProjectMVC2.Models.Post

@{
    ViewData["Title"] = Model.PostTitle;
    Layout = "~/Views/Shared/_introLayout.cshtml";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <article class="blog-post">
                <h1 class="mb-4">@Model.PostTitle</h1>

                <div class="post-meta mb-4">
                    <span class="text-muted">@Model.PublishDate.ToString("dd MMMM yyyy")</span>
                </div>

                @if (!string.IsNullOrEmpty(Model.PostImageUrl))
                {
                    <img src="@Model.PostImageUrl" class="img-fluid mb-4" alt="@Model.PostTitle">
                }

                <div class="post-content">
                    @Html.Raw(Model.PostContent)
                </div>

                <div class="comments-section mt-5">
                    <h3>Yorumlar</h3>
                    @if (Model.comments != null && Model.comments.Any())
                    {
                        foreach (var comment in Model.comments)
                        {
                            <div class="comment mb-3">
                                <div class="comment-meta">
                                    <strong>@comment.User.UserName</strong>
                                    <span class="text-muted">@comment.CommentPublishDate.ToString("dd MMMM yyyy")</span>
                                </div>
                                <div class="comment-content">
                                    @comment.CommentContent
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p>Henüz yorum yapılmamış.</p>
                    }
                </div>
            </article>
        </div>
    </div>
</div>